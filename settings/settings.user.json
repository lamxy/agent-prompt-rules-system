  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "zsh -c '. ~/.zshrc'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/skills/myhandoff/scripts/handoff-hook\" claude stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/skills/myhandoff/scripts/handoff-hook\" claude stop-failure",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "open-code-review@open-code-review": true,
    "ralph-loop@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      },
      "autoUpdate": true
    },
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      }
    }
  },
  "language": "traditional chinese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "deniedDomains": [
        "gist.github.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.cache",
        "~/.npm",
        "~/.pnpm-store",
        "~/.kube",
        "~/.cargo",
        "~/.rustup",
        "~/.bun",
        "~/.yarn",
        "~/.cache/pip",
        "~/.local/share/virtualenvs",
        "~/go/pkg",
        "~/go/bin"
      ],
      "denyRead": [
        "~/.docker",
        "~/.bashrc",
        "~/.zshrc",
        "~/.oh-my-zsh",
        "~/.profile",
        "~/.bash_profile",
        "~/.zprofile",
        "~/.bash_history",
        "~/.zsh_history",
        "~/",
        "~"
      ],
      "allowRead": [
        ".",
        "~/.local/bin",
        "~/.gitconfig",
        "~/.npmrc",
        "~/.config/pip",
        "~/.cargo",
        "~/.rustup",
        "~/.ssh/config",
        "~/.kube/config",
        "~/.nvm",
        "~/.config/pypoetry"
      ]
    },
    "excludedCommands": [
      "docker *"
    ]
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "dialogExpiry": "5m",
  "pluginConfigs": {},
  "tui": "fullscreen",
  "theme": "dark",
  "verbose": true,
  "autoMode": {
    "environment": [
      "Allow frontend development workflows using npm, pnpm, or yarn, including TypeScript type-checking (tsc), Vite/Vue-CLI builds, and running local frontend dev servers.",
      "Allow Go backend development tasks including module management (go mod tidy), code linting/formatting, running unit tests (go test), and executing local Go API servers (go run, air).",
      "Allow executing database migration tools (golang-migrate, GORM auto-migration) and managing local MySQL containers via Docker/docker-compose for local development and testing only.",
      "Allow file reading, writing, and code refactoring strictly within the active project root directory. Do not exfiltrate sensitive files or env credentials."
    ],
    "classifyAllShell": true
  },
  "skippedPlugins": [],
  "skillOverrides": {
    "claude-api": "user-invocable-only"
  }
}
