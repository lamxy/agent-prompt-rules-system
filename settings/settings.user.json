{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "rtk hook claude"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "prompt",
                        "timeout": 15,
                        "prompt": "You are a strict-but-minimal completion gate for the main agent. Approve by default. Block only when both are true: (1) the current turn performed meaningful work (tool use, edits, or analysis output), and (2) the latest assistant output does not clearly include both a concrete result and a concrete next step. If blocking, return JSON exactly: {\"decision\":\"block\",\"reason\":\"Missing completion summary: include result and next step.\"}. Otherwise return JSON exactly: {\"decision\":\"approve\"}. If uncertain, approve."
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                    "matcher": "*",
                    "hooks": [
                    {
                    "type": "command",
                    "command": "python .claude/hooks/subagent_stop_gate.py"
                }
                ]
            }
        ],
        "PreCompact": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "prompt",
                        "timeout": 15,
                        "prompt": "Before compaction, preserve only minimal verified state. Never block. Generate at most three short lines in systemMessage with this exact key style: keep.result=<...>; keep.risk=<low|medium|high|unknown>; keep.next=<...>. Include only if clearly supported by the latest verified context. If insufficient evidence, return JSON exactly: {}."
                    }
                ]
            }
        ]
    },    
	"enabledPlugins": {
        "github@claude-plugins-official": true,
        "andrej-karpathy-skills@karpathy-skills": true,
		"remember@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "hookify@claude-plugins-official": true,
        "playground@claude-plugins-official": true,
        "optibot@claude-plugins-official": true,
        "commit-commands@claude-code-plugins": true,
        "context7@claude-code-plugins": true,
        "ralph-loop@claude-code-plugins": true,
        "session-report@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        },
        "claude-code-plugins": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-code"
            }
        },
        "karpathy-skills": {
            "source": {
                "source": "github",
                "repo": "forrestchang/andrej-karpathy-skills"
            }
        }
	}
}
