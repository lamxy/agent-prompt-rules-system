{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "MDB_MCP_READ_ONLY": "true"
    },
    "enabledPlugins": {
        "typescript-native-lsp@anthropic-plugin-directory": true,
        "frontend-design@claude-plugins-official": true,
        "playwright@claude-plugins-official": true,
        "chrome-devtools-mcp@claude-plugins-official": true,
        "modern-web-guidance@claude-plugins-official": true,
        "playground@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true,
        "sentry@claude-plugins-official": true,
        "gopls-lsp@claude-plugins-official": true,
        "mongodb@claude-plugins-official": true,
        "redis-development@claude-plugins-official": true,
        "semgrep@claude-plugins-official": true,
        "mattpocock-skills@claude-plugins-official": true
    },
    "permissions": {
        "deny": [
            "Bash(mongosh *--eval *drop*)",
            "Bash(mongosh *--eval *deleteMany*)",
            "Bash(mongosh *--eval *remove*)",
            "Bash(mongosh *--eval *updateMany*)",
            "Bash(mongo *--eval *drop*)",
            "Bash(mongo *--eval *deleteMany*)",
            "Bash(mysql *-e *DROP*)",
            "Bash(mysql *-e *TRUNCATE*)",
            "Bash(mysql *-e *DELETE*)",
            "Bash(psql *-c *DROP*)",
            "Bash(psql *-c *TRUNCATE*)",
            "Bash(psql *-c *DELETE*)",
            "Bash(redis-cli *flushall*)",
            "Bash(redis-cli *FLUSHALL*)",
            "Bash(redis-cli *flushdb*)",
            "Bash(redis-cli *FLUSHDB*)",
            "mcp__plugin_mongodb_mongodb__atlas-local-create-deployment",
            "mcp__plugin_mongodb_mongodb__atlas-local-delete-deployment",
            "mcp__plugin_mongodb_mongodb__create-collection",
            "mcp__plugin_mongodb_mongodb__create-index",
            "mcp__plugin_mongodb_mongodb__delete-many",
            "mcp__plugin_mongodb_mongodb__drop-collection",
            "mcp__plugin_mongodb_mongodb__drop-database",
            "mcp__plugin_mongodb_mongodb__drop-index",
            "mcp__plugin_mongodb_mongodb__insert-many",
            "mcp__plugin_mongodb_mongodb__rename-collection",
            "mcp__plugin_mongodb_mongodb__update-many"
        ],
        "ask": [
            "mcp__mysql__execute_sql",
            "mcp__postgres__execute_sql",
            "Bash(docker compose down*)",
            "Bash(docker compose * down*)",
            "Bash(docker-compose down*)",
            "Bash(docker-compose * down*)"
        ]
    },
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        }
    }
}
