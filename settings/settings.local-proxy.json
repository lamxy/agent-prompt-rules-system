{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
    "availableModels": [
        "gpt-5.3-codex",
        "gpt-5.5",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-image-2",
        "gemini-3.1-pro-preview",
        "gemini-3-pro-high",
        "gemini-3-pro-preview",
        "gemini-3.1-flash-image",
        "gemini-3.1-pro-low",
        "gemini-3-flash",
        "gemini-3.1-pro-low",
        "claude-sonnet-4-6",
        "claude-opus-4-6-thinking",
        "gemini-3-flash",
        "claude-haiku-4.6",
        "claude-opus-4.6",
        "claude-sonnet-4.6",
        "anthropic/claude-sonnet-4.6",
        "google/gemini-3.1-flash-lite",
        "google/gemini-3.1-pro-preview",
        "google/gemini-3.1-flash-image-preview",
        "google/gemini-3.1-flash-lite-preview",
        "google/gemini-3.5-flash",
        "openai/gpt-5.3-codex",
        "openai/gpt-5.4-mini",
        "openai/gpt-5.4",
        "openai/gpt-5.5"
    ],
    "env": {
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gemini-3-flash",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "gemini-3.1-pro-low",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "anthropic/claude-sonnet-4.6",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_TELEMETRY": "1",
        "ENABLE_TOOL_SEARCH": "true"
    },
    "includeGitInstructions": false,
	"enabledPlugins": {
		"github@claude-plugins-official": true,
        "andrej-karpathy-skills@karpathy-skills": true,
		"remember@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "hookify@claude-plugins-official": true,
        "playground@claude-plugins-official": true,
        "optibot@claude-plugins-official": true,
        "commit-commands@claude-code-plugins": true,
        "context7@claude-code-plugins": true,
        "ralph-loop@claude-code-plugins": true,
        "session-report@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
		"claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        },
        "claude-code-plugins": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-code"
            }
        },
        "karpathy-skills": {
            "source": {
                "source": "github",
                "repo": "forrestchang/andrej-karpathy-skills"
            }
        }
	}
}
