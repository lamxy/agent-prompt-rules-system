#!/usr/bin/env python3
"""myopensupports：按序號列出、產生安裝方案、移除本倉庫 open_supports/ 的支持包。

子命令：
  list                                   列出本機清單與目標專案的安裝狀態（預設）
  install <選擇> [-- 自訂參數...]        只印安裝方案（預設參數、完整命令、安裝示例），不執行
  remove <選擇>                          只印移除方案，不刪除
  remove-apply <選擇>                    把本倉庫安裝產生的檔案搬到備份目錄（等於刪除）
  add <Owner/Repo | ost_Owner_Repo>      從倉庫加入本機清單
  sync [--dry-run|-t|--test]             依倉庫支持包更新本機清單

選擇：序號、ost_ 目錄名或 Owner/Repo。共用選項：--target <專案目錄>。
環境變數：AGENT_RULES_REPO（必要，本倉庫在本機的克隆路徑）、
MYOPENSUPPORTS_HOME（清單目錄，預設 ~/.claude/myopensupports）、
MYOPENSUPPORTS_PROJECT_DIR（預設 CLAUDE_PROJECT_DIR，再退回目前目錄的 git 根目錄）。
"""
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

HOME_DIR = os.environ.get("MYOPENSUPPORTS_HOME") or os.path.expanduser("~/.claude/myopensupports")
CATALOG = os.path.join(HOME_DIR, "catalog.json")
SELF_CMD = "python3 ~/.claude/skills/myopensupports/scripts/myopensupports"
TEMPLATE_PKG = "ost_GithubName_RepoName_TEMPLATE"
MARKER = "<!-- generated by scripts/install-open-supports.sh; delete this line to keep manual edits -->"
PROJECT_ARGS = ("{PROJECT_DIR}", "--local", "--location=local")
DRY_FLAGS = ("--dry-run", "-t", "--test")
NOTES = []


class Fail(Exception):
    pass


def note(msg):
    NOTES.append("注意：" + msg)


# ---------- 倉庫與專案 ----------

def locate_repo():
    raw = (os.environ.get("AGENT_RULES_REPO") or "").strip()
    hint = ("請設定本倉庫（agent-prompt-rules-system）在本機的克隆路徑：在 shell profile 加入 "
            "export AGENT_RULES_REPO=/path/to/agent-prompt-rules-system，或在 ~/.claude/settings.json 的 "
            "env 加入 \"AGENT_RULES_REPO\"，然後重開 Claude")
    if not raw:
        raise Fail("環境變數 AGENT_RULES_REPO 未設定或為空。" + hint)
    repo = os.path.realpath(os.path.expanduser(raw))
    if not (os.path.isfile(os.path.join(repo, "scripts", "install-open-supports.sh"))
            and os.path.isfile(os.path.join(repo, "open_supports", "INDEX.md"))):
        raise Fail("AGENT_RULES_REPO=%s 不是本倉庫（找不到 scripts/install-open-supports.sh 或 "
                   "open_supports/INDEX.md）。%s" % (raw, hint))
    return repo


def project_dir(target=None):
    p = target or os.environ.get("MYOPENSUPPORTS_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR")
    if not p:
        try:
            p = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                               text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            p = ""
        p = p or os.getcwd()
    p = os.path.realpath(os.path.expanduser(p))
    if not os.path.isdir(p):
        raise Fail("目標專案目錄不存在：%s" % p)
    return p


# ---------- 倉庫索引 ----------

def _cells(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def parse_index(repo):
    """回傳 INDEX「已收录支持包」表格中的包（dict，以 name 為鍵）。"""
    path = os.path.join(repo, "open_supports", "INDEX.md")
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    out, in_sec, in_table = {}, False, False
    for line in lines:
        if line.startswith("#"):
            if in_sec and in_table:
                break
            in_sec = "已收录支持包" in line or "已收錄支持包" in line
            continue
        if not in_sec:
            continue
        if not line.strip().startswith("|"):
            if in_table:
                break
            continue
        in_table = True
        cells = _cells(line)
        if cells and (cells[0] in ("支持包",) or set(cells[0]) <= set("-: ")):
            continue
        m = re.fullmatch(r"`?(ost_[^`\s]+)`?", cells[0]) if cells else None
        up = re.search(r"\[([^\]]+/[^\]]+)\]", cells[1]) if len(cells) > 1 else None
        if not m or not up or len(cells) < 5:
            note("INDEX 有一列無法解析，已略過：%s" % line.strip()[:60])
            continue
        out[m.group(1)] = {"name": m.group(1), "upstream": up.group(1), "purpose": cells[2],
                           "scope": cells[3], "scenes": cells[4], "indexed": True}
    return out


def pkg_dirs(repo):
    base = os.path.join(repo, "open_supports")
    return sorted(d for d in os.listdir(base)
                  if d.startswith("ost_") and d != TEMPLATE_PKG and os.path.isdir(os.path.join(base, d)))


def upstream_from_name(name):
    rest = name[len("ost_"):]
    return rest.replace("_", "/", 1)


def repo_packages(repo):
    """INDEX 已登記且目錄存在的包（依 INDEX 順序）。"""
    idx = parse_index(repo)
    dirs = set(pkg_dirs(repo))
    return [p for n, p in idx.items() if n in dirs]


def unindexed_pkg(repo, name):
    return {"name": name, "upstream": upstream_from_name(name), "purpose": "（INDEX 未登記）",
            "scope": "", "scenes": "", "indexed": False}


def read_list(path):
    """讀清單檔，回傳 [(upstream 或 ost 名, 參數字串, 是否註解行)]。"""
    rows = []
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return rows
    for line in text.splitlines():
        s = line.strip()
        commented = s.startswith("#")
        if commented:
            s = s.lstrip("#").strip()
        if not s:
            continue
        parts = s.split(None, 1)
        rows.append((parts[0], parts[1] if len(parts) > 1 else "", commented))
    return rows


def matches(pkg, token):
    return token in (pkg["name"], pkg["upstream"])


def global_list_path(repo):
    return os.path.join(repo, "dot_claude_projects", ".claude", "open_supports_name_list.txt")


def is_global_only(repo, pkg):
    if re.match(r"^\W*(全局|全域)", pkg.get("scenes", "")):
        return True
    return any(matches(pkg, t) and not c for t, _, c in read_list(global_list_path(repo)))


# ---------- 本機清單 ----------

def save_catalog(cat):
    os.makedirs(HOME_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=HOME_DIR, prefix=".myopensupports-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cat, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, CATALOG)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise Fail("無法寫入 %s（%s）。在沙箱中執行時，需在 ~/.claude/settings.json 的 sandbox.excludedCommands "
                   "加入「%s *」（照字面，含 ~），並用同樣的 ~ 寫法執行本腳本" % (CATALOG, e.strerror, SELF_CMD))


def load_catalog(repo):
    if os.path.exists(CATALOG):
        try:
            with open(CATALOG, encoding="utf-8") as f:
                cat = json.load(f)
        except ValueError as e:
            raise Fail("無法解析 %s（%s），未寫入任何檔案" % (CATALOG, e))
        cat.setdefault("packages", [])
        return cat
    cat = {"packages": repo_packages(repo)}
    save_catalog(cat)
    return cat


def resolve(cat, sel):
    pk = cat["packages"]
    if not sel:
        raise Fail("請指定支持包序號或名稱")
    out = []
    for s in sel:
        if s.isdigit():
            i = int(s)
            if not 1 <= i <= len(pk):
                raise Fail("序號 %s 超出範圍（1～%d）" % (s, len(pk)))
            out.append(pk[i - 1])
            continue
        hit = [p for p in pk if matches(p, s)]
        if not hit:
            raise Fail("清單中沒有 %s；先執行 list 查看，或用 add 加入" % s)
        out.append(hit[0])
    return out


def advisory(pkg):
    """INDEX 建議場景標明不安裝時，回傳標籤（不啟用／手動挑選）；否則 None。"""
    scenes = re.sub(r"^[\W_]+", "", pkg.get("scenes", ""))
    if scenes.startswith(("不直接安装", "不直接安裝")):
        return "手動挑選"
    if scenes.startswith(("不启用", "不啟用", "暂不启用", "暫不啟用")):
        return "不啟用"
    return None


def installed_state(repo, proj, pkg):
    if os.path.isdir(os.path.join(proj, ".claude", "open_supports", pkg["name"])):
        return "已安裝"
    if is_global_only(repo, pkg):
        return "全域（未偵測）"
    return "未安裝"


# ---------- list / sync / add ----------

def cmd_list(repo, cat, proj):
    dirs = set(pkg_dirs(repo))
    current = repo_packages(repo)
    have = {p["name"] for p in cat["packages"]}
    new = [p["name"] for p in current if p["name"] not in have]
    print("倉庫：%s" % repo)
    print("目標專案：%s" % proj)
    print("可選支持包：")
    w = max([len(p["name"]) for p in cat["packages"]] + [10])
    for i, p in enumerate(cat["packages"], 1):
        st = "倉庫已無" if p["name"] not in dirs else installed_state(repo, proj, p)
        mark = "✅" if st == "已安裝" else ("⚠️" if st == "倉庫已無" else "⬜")
        adv = advisory(p)
        print("%3d. %-*s %s %-14s [%s] %s%s" % (i, w, p["name"], mark, st, p.get("scope") or "-",
                                             "〔%s〕" % adv if adv else "", p.get("purpose", "")))
    if new:
        note("倉庫有 %d 個新支持包（%s），執行 sync 加入" % (len(new), "、".join(new)))
    if any(p["name"] not in dirs for p in cat["packages"]):
        note("標「倉庫已無」的支持包已不在倉庫，執行 sync 移出清單")


def cmd_sync(repo, cat, rest):
    dry = any(a in DRY_FLAGS for a in rest)
    dirs = set(pkg_dirs(repo))
    current = {p["name"]: p for p in repo_packages(repo)}
    added, removed, updated, keep = [], [], [], []
    for p in cat["packages"]:
        if p["name"] not in dirs:
            removed.append(p["name"])
            continue
        fresh = current.get(p["name"])
        if fresh is None and p.get("indexed"):
            fresh = unindexed_pkg(repo, p["name"])
        if fresh is None:
            keep.append(p)
            continue
        if any(p.get(k) != fresh[k] for k in ("upstream", "purpose", "scope", "scenes", "indexed")):
            updated.append(p["name"])
        keep.append(fresh)
    names = {p["name"] for p in keep}
    for n, p in current.items():
        if n not in names:
            keep.append(p)
            added.append(n)
    print("%s新增 %d：%s" % ("預演，" if dry else "", len(added), "、".join(added) or "無"))
    print("移除 %d：%s" % (len(removed), "、".join(removed) or "無"))
    print("更新 %d：%s" % (len(updated), "、".join(updated) or "無"))
    if dry:
        print("（預演，未寫入；去掉預演旗標再執行一次即可寫入）")
        return
    if added or removed or updated:
        cat["packages"] = keep
        save_catalog(cat)
        print("已更新清單，序號已重排，以 list 為準。")


def cmd_add(repo, cat, rest):
    if len(rest) != 1:
        raise Fail("用法：add <Owner/Repo 或 ost_Owner_Repo>")
    tok = rest[0].strip()
    name = tok if tok.startswith("ost_") else "ost_" + tok.replace("/", "_", 1)
    if name == TEMPLATE_PKG or name not in pkg_dirs(repo):
        raise Fail("倉庫 open_supports/ 中找不到 %s：尚未建立該支持包" % name)
    if any(p["name"] == name for p in cat["packages"]):
        print("%s 已在清單，未變更。" % name)
        return
    pkg = parse_index(repo).get(name)
    if not pkg:
        pkg = unindexed_pkg(repo, name)
        note("%s 未登記在 open_supports/INDEX.md，分類與用途未知" % name)
    cat["packages"].append(pkg)
    save_catalog(cat)
    print("已加入 %s（序號 %d）。" % (name, len(cat["packages"])))


# ---------- install ----------

def install_script(repo, pkg):
    hits = sorted(glob.glob(os.path.join(repo, "open_supports", pkg["name"], "scripts_for_install", "install.*")))
    return hits[0] if hits else None


def script_help(repo, pkg):
    """安裝腳本開頭註解的「用法／選項／示例」段。"""
    path = install_script(repo, pkg)
    if not path:
        return None
    out, on = [], False
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.rstrip("\n")
            if not on:
                if re.match(r"^#\s*(用法|Usage)", line, re.I):
                    on = True
                else:
                    continue
            if not line.startswith("#") or re.match(r"^#\s*(={3,}|说明|說明|注意|Notes?\b)", line, re.I):
                break
            out.append(re.sub(r"^# ?", "", line))
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out) if out else None


def example_lines(help_text):
    ex, on = [], False
    for line in (help_text or "").splitlines():
        if re.match(r"^\s*(示例|範例|Examples?)", line, re.I):
            on = True
            continue
        if on:
            m = re.match(r"^\s*\./install\.\w+\s*(.*?)\s*(#.*)?$", line)
            if m:
                ex.append(m.group(1))
    return ex


def to_project_args(ex):
    """把示例中的專案路徑換成 {PROJECT_DIR}；不是專案級示例時回傳 None。"""
    out, found = [], False
    for tok in ex.split():
        m = re.match(r"^(--project(?:-dir)?=)(.+)$", tok)
        if m:
            out.append(m.group(1) + "{PROJECT_DIR}")
            found = True
        elif tok in (".", "TARGET_DIR") or tok.startswith(("/", "~")):
            out.append("{PROJECT_DIR}")
            found = True
        else:
            out.append(tok)
    if not found and any(t in ("--local", "--location=local") for t in out):
        out.append("{PROJECT_DIR}")
        found = True
    return " ".join(out) if found else None


def default_args(repo, pkg):
    """回傳 [(參數字串, 來源說明)]，第一個為預設。"""
    out = []
    glob_only = is_global_only(repo, pkg)
    if glob_only:
        out += [(a, "全域清單 dot_claude_projects/.claude") for t, a, c in read_list(global_list_path(repo))
                if not c and matches(pkg, t)]
    lists = sorted(glob.glob(os.path.join(repo, "dot_claude_projects", ".claude-*", ".claude",
                                          "open_supports_name_list.txt")))
    for path in lists:
        flag = path.split(os.sep)[-3][len(".claude-"):]
        if flag.endswith("_template"):
            continue
        for t, a, c in read_list(path):
            if matches(pkg, t):
                item = (a, "場景清單 %s%s" % (flag, "（註解行，次場景）" if c else ""))
                if item[0] not in [x[0] for x in out]:
                    out.append(item)
    if out:
        # 未註解的行優先
        out.sort(key=lambda x: "註解行" in x[1])
        return out
    exs = example_lines(script_help(repo, pkg))
    # 有提到 claude 的示例優先
    exs = [e for e in exs if "claude" in e] + [e for e in exs if "claude" not in e]
    for ex in exs:
        proj_args = to_project_args(ex)
        if glob_only and proj_args is None:
            return [(ex, "取自安裝腳本示例（不帶專案路徑）")]
        if not glob_only and proj_args is not None:
            return [(proj_args, "取自安裝腳本示例")]
    return []


def is_project_args(args):
    toks = args.split()
    return "{PROJECT_DIR}" in args or any(t in ("--local", "--location=local") for t in toks)


def has_project_path(args):
    return "{PROJECT_DIR}" in args or any(re.match(r"^--project(-dir)?=", t) for t in args.split())


def build_command(repo, proj, pkg, args, dry=False):
    """回傳 (命令字串, 是否全域)。路徑與參數都以 shlex.quote 引用；-n 傳 ost_ 目錄名。"""
    script = os.path.join(repo, "scripts", "install-open-supports.sh")
    is_global = is_global_only(repo, pkg) and not is_project_args(args)
    head = ["sh", script] + (["-g"] if is_global else ["-t", proj]) + ["-n", pkg["name"]]
    if dry:
        head.append("--dry-run")
    tail = (["--"] + args.split()) if args else []
    return " ".join(shlex.quote(x) for x in head + tail), is_global


def cmd_install(repo, cat, proj, sel, custom):
    if custom is not None and any(" " in a or "\t" in a for a in custom):
        raise Fail("參數值不能含空格（install-open-supports.sh 不支援）：%s" % " ".join(repr(a) for a in custom))
    pkgs = resolve(cat, sel)
    for pkg in pkgs:
        if pkg["name"] not in pkg_dirs(repo):
            raise Fail("%s 已不在倉庫，執行 sync 更新清單" % pkg["name"])
    for pkg in pkgs:
        print("=== %s（%s）" % (pkg["name"], pkg["upstream"]))
        print("分類：%s　建議場景：%s　用途：%s" % (pkg.get("scope") or "-", pkg.get("scenes") or "-",
                                            pkg.get("purpose") or "-"))
        print("目標專案：%s" % proj)
        adv = advisory(pkg)
        if adv == "不啟用":
            note("%s 在 INDEX 標為不啟用（%s）；不建議安裝，預設參數僅供參考" % (pkg["name"], pkg.get("scenes")))
        elif adv == "手動挑選":
            note("%s 在 INDEX 標為手動挑選（%s）；不建議直接安裝，需要的內容已挑選進本倉庫，預設參數僅供參考"
                 % (pkg["name"], pkg.get("scenes")))
        defaults = default_args(repo, pkg)
        if custom is not None:
            args, src = " ".join(custom), "自訂參數"
        elif defaults:
            args, src = defaults[0]
        else:
            args, src = "", None
        print()
        if src:
            print("預設參數：%s" % (args or "（無參數）") if src != "自訂參數" else "自訂參數：%s" % (args or "（無參數）"))
            print("來源：%s" % src)
        else:
            print("預設參數：無預設參數（場景清單與安裝腳本示例都沒有可用的設定），請從下方示例選擇後用自訂參數")
        others = [d for d in defaults if d[0] != args]
        if others:
            print("其他可選參數：")
            for a, s in others:
                print("  - %s　（%s）" % (a or "（無參數）", s))
        print()
        if src:
            cmd, is_global = build_command(repo, proj, pkg, args)
            if is_global:
                print("此包預設全域安裝，作用於所有專案（不需要專案目錄）。")
            elif not has_project_path(args):
                note("參數沒有 {PROJECT_DIR}：安裝腳本會在複製後的支持包目錄中執行，預設路徑不會指向專案；"
                     "專案級安裝請在參數中加上 {PROJECT_DIR}")
            print("完整命令：")
            print("  " + cmd)
            print("預演命令（建議先執行）：")
            print("  " + build_command(repo, proj, pkg, args, dry=True)[0])
        else:
            print("沒有預設參數，不產生命令；請從下方示例選擇參數後，用自訂參數重新產生。")
        help_text = script_help(repo, pkg)
        print()
        if help_text:
            print("安裝示例（取自 %s）：" % os.path.relpath(install_script(repo, pkg), repo))
            for line in help_text.splitlines():
                print("  " + line)
        else:
            path = install_script(repo, pkg)
            print("找不到安裝腳本的用法說明%s" % ("，請直接查看 %s" % path if path else "（找不到安裝腳本）"))
        print()
        print("自訂參數：/myopensupports %s -- <參數…>（{PROJECT_DIR} 會替換為專案絕對路徑）" % pkg["name"])
        print()


# ---------- remove ----------

def uninstall_notes(repo, pkg):
    path = os.path.join(repo, "open_supports", pkg["name"], "repo_readme_summary.md")
    try:
        with open(path, encoding="utf-8") as f:
            return [l.strip() for l in f if re.search(r"卸载|卸載|uninstall", l, re.I)]
    except OSError:
        return []


def unique_backup_dir(proj):
    base = os.path.join(proj, ".claude", "open_supports.backup-%s" % time.strftime("%Y%m%d-%H%M%S"))
    path, n = base, 1
    while os.path.lexists(path):
        path, n = "%s.%d" % (base, n), n + 1
    return path


def rollback(done):
    restored, stuck = [], []
    for path, dest in reversed(done):
        try:
            shutil.move(dest, path)
            restored.append(path)
        except (OSError, shutil.Error):
            stuck.append("%s（在 %s）" % (path, dest))
    return restored, stuck


def prune_empty(top):
    for root, _, _ in sorted(os.walk(top), key=lambda x: -len(x[0])):
        try:
            os.rmdir(root)
        except OSError:
            pass


def cmd_remove(repo, cat, proj, sel, apply):
    pkgs = resolve(cat, sel)
    backup = None
    for pkg in pkgs:
        name = pkg["name"]
        vend = os.path.join(proj, ".claude", "open_supports", name)
        wrap = os.path.join(proj, ".claude", "skills", "%s_install" % name)
        print("=== %s（%s）" % (name, pkg["upstream"]))
        print("目標專案：%s" % proj)
        targets, kept = [], []
        if os.path.lexists(vend):
            targets.append((vend, "packages/%s" % name))
        if os.path.lexists(wrap):
            try:
                with open(os.path.join(wrap, "SKILL.md"), encoding="utf-8") as f:
                    generated = MARKER in f.read().splitlines()
            except OSError:
                generated = False
            if generated:
                targets.append((wrap, "skills/%s_install" % name))
            else:
                kept.append(wrap)
        if not targets and not kept:
            print("目標專案未安裝此支持包（沒有本倉庫產生的檔案），不需刪除。")
        elif not targets:
            print("沒有可刪除的檔案。")
        if apply and targets:
            backup = backup or unique_backup_dir(proj)
            # 先搬 .claude/skills/（沙箱最常擋），失敗時把已搬的移回原位，避免只刪一半
            targets.sort(key=lambda t: not t[1].startswith("skills/"))
            done = []
            for path, rel in targets:
                dest = os.path.join(backup, rel)
                try:
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    shutil.move(path, dest)
                except (OSError, shutil.Error) as e:
                    restored, stuck = rollback(done)
                    prune_empty(backup)
                    msg = "移動 %s 失敗（%s）" % (path, e)
                    if restored:
                        msg += "；已把先搬走的 %s 移回原位" % "、".join(restored)
                    if stuck:
                        msg += "；以下項目無法移回，仍在備份目錄：%s" % "、".join(stuck)
                    raise Fail(msg + "；專案未被修改" if not stuck else msg)
                done.append((path, dest))
            print("已移到備份目錄 %s（等於從專案刪除）：" % backup)
            for path, _ in targets:
                print("  - %s" % path)
        elif targets:
            print("將刪除（搬到 <專案>/.claude/open_supports.backup-<時間戳>/，可搬回復原）：")
            for path, _ in targets:
                print("  - %s" % path)
            print("完整命令（執行後才會刪除）：")
            print("  %s remove-apply %s --target %s" % (SELF_CMD, name, shlex.quote(proj)))
        for k in kept:
            print("  - 保留 %s：沒有生成標記，屬手動維護，請自行決定是否刪除" % k)
        notes = uninstall_notes(repo, pkg)
        print("上游工具本身的卸載（本技能不執行）：")
        if notes:
            for n in notes:
                print("  %s" % n)
        else:
            print("  支持包文件未記載卸載方式；請查上游官方文件。")
        lst = os.path.join(proj, ".claude", "open_supports_name_list.txt")
        if any(matches(pkg, t) and not c for t, _, c in read_list(lst)):
            note("%s 仍有 %s 的設定行，之後依清單重裝會再裝回來；需要時自行刪除或註解該行" % (lst, name))
        print()


# ---------- main ----------

def split_opts(rest):
    """取出 --target 與 -- 之後的自訂參數。"""
    target, custom, out = None, None, []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--":
            custom = rest[i + 1:]
            break
        if a == "--target":
            if i + 1 >= len(rest):
                raise Fail("--target 需要目錄")
            target = rest[i + 1]
            i += 2
            continue
        if a.startswith("--target="):
            target = a.split("=", 1)[1]
        else:
            out.append(a)
        i += 1
    return out, target, custom


def main(argv):
    repo = locate_repo()
    cmd = argv[0] if argv else "list"
    rest = argv[1:]
    known = ("list", "install", "remove", "rm", "remove-apply", "add", "sync")
    if cmd not in known:
        cmd, rest = "install", argv
    rest, target, custom = split_opts(rest)
    cat = load_catalog(repo)
    try:
        if cmd == "list":
            cmd_list(repo, cat, project_dir(target))
        elif cmd == "install":
            cmd_install(repo, cat, project_dir(target), rest, custom)
        elif cmd in ("remove", "rm"):
            if "--apply" in rest:
                raise Fail("刪除請用 remove-apply 子命令（需要使用者核准）")
            cmd_remove(repo, cat, project_dir(target), rest, False)
        elif cmd == "remove-apply":
            cmd_remove(repo, cat, project_dir(target), rest, True)
        elif cmd == "add":
            cmd_add(repo, cat, rest)
        elif cmd == "sync":
            cmd_sync(repo, cat, rest)
    finally:
        for n in NOTES:
            print(n)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        for n in NOTES:
            print(n)
        print("錯誤：%s" % e, file=sys.stderr)
        sys.exit(2)
