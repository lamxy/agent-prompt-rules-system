#!/usr/bin/env python3
"""myplugins：在目前專案按序號啟用或關閉可選插件，並維護可選插件清單。

子命令：
  list | status                    列出清單與本專案狀態（預設）
  enable <選擇...> [--shared] [--dry-run]
  off <選擇...> [--shared] [--dry-run]
  add <名稱@市場> [說明...] [--category 類別]
  remove <選擇...>
  hint                             SessionStart hook 用，輸出提示 JSON

選擇：序號（1 3 5）、插件 id 或名稱、all。
寫入：預設 .claude/settings.local.json（個人）；--shared 寫 .claude/settings.json（共享）。
環境變數：MYPLUGINS_HOME（清單目錄，預設 ~/.claude/myplugins）、
MYPLUGINS_CLAUDE_DIR（預設 ~/.claude）、MYPLUGINS_PROJECT_DIR（預設 CLAUDE_PROJECT_DIR 或目前目錄）。
"""
import json
import os
import subprocess
import sys
import tempfile

OFFICIAL = "claude-plugins-official"
HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_CATALOG = os.path.join(os.path.dirname(HERE), "catalog.default.json")
CLAUDE_DIR = os.environ.get("MYPLUGINS_CLAUDE_DIR") or os.path.expanduser("~/.claude")
HOME_DIR = os.environ.get("MYPLUGINS_HOME") or os.path.join(CLAUDE_DIR, "myplugins")
CATALOG = os.path.join(HOME_DIR, "catalog.json")


def project_dir():
    return (os.environ.get("MYPLUGINS_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR")
            or os.getcwd())


class Fail(Exception):
    pass


def load_json(path, default):
    if not os.path.exists(path):
        return default
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
        return json.loads(text) if text.strip() else default
    except ValueError as e:
        raise Fail("無法解析 %s（%s），未寫入任何檔案" % (path, e))


def save_json(path, data):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".myplugins-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise Fail("無法寫入 %s（%s）。在沙箱中執行時，需把本腳本加入 sandbox.excludedCommands，見技能說明" % (path, e.strerror))


def load_catalog():
    if not os.path.exists(CATALOG):
        seed = load_json(DEFAULT_CATALOG, {"plugins": []})
        save_json(CATALOG, seed)
    cat = load_json(CATALOG, {"plugins": []})
    cat.setdefault("plugins", [])
    return cat


def layer_paths():
    p = project_dir()
    return {
        "user": os.path.join(CLAUDE_DIR, "settings.json"),
        "shared": os.path.join(p, ".claude", "settings.json"),
        "local": os.path.join(p, ".claude", "settings.local.json"),
    }


def layer_plugins():
    out = {}
    for name, path in layer_paths().items():
        try:
            out[name] = load_json(path, {}).get("enabledPlugins", {}) or {}
        except Fail:
            out[name] = {}
    return out


def installed_ids():
    data = load_json(os.path.join(CLAUDE_DIR, "plugins", "installed_plugins.json"), {})
    ids = set()
    for pid, recs in (data.get("plugins") or {}).items():
        for r in recs if isinstance(recs, list) else [recs]:
            if os.path.isdir(r.get("installPath", "")):
                ids.add(pid)
    return ids


def state(pid, layers):
    """回傳 (是否生效, 來源層)。優先級 local > shared > user。"""
    for name, label in (("local", "本地"), ("shared", "共享"), ("user", "全局")):
        if pid in layers[name]:
            return bool(layers[name][pid]), label
    return False, "未設定"


def resolve(cat, args):
    plugins = cat["plugins"]
    if not args:
        raise Fail("請指定序號、插件名稱或 all")
    if len(args) == 1 and args[0] == "all":
        return [p["id"] for p in plugins]
    picked = []
    for a in args:
        for tok in a.replace(",", " ").split():
            if tok.isdigit():
                n = int(tok)
                if not 1 <= n <= len(plugins):
                    raise Fail("序號 %d 超出範圍（1～%d）" % (n, len(plugins)))
                pid = plugins[n - 1]["id"]
            else:
                hits = [p["id"] for p in plugins if p["id"] == tok or p["id"].split("@")[0] == tok]
                if not hits:
                    raise Fail("清單中沒有「%s」；先用 add 加入" % tok)
                pid = hits[0]
            if pid not in picked:
                picked.append(pid)
    return picked


def cmd_list(cat):
    layers, inst = layer_plugins(), installed_ids()
    print("可選插件（專案：%s）" % project_dir())
    if not cat["plugins"]:
        print("  清單為空，用 add <名稱@市場> 加入")
    for i, p in enumerate(cat["plugins"], 1):
        on, src = state(p["id"], layers)
        mark = ("啟用（%s）" % src) if on else ("停用（%s）" % src if src != "未設定" else "停用")
        if p["id"] not in inst:
            mark += "，未安裝"
        print("%3d. %-48s %-14s [%s] %s" % (i, p["id"], mark, p.get("category", "-"), p.get("description", "")))
    print("\n用法：/myplugins 3 | 1 4 6 | all（預設寫入本地個人設定，加 --shared 寫入專案共享設定）")
    print("      /myplugins off 3 | off all [--shared]；add <名稱@市場> [說明]；remove <序號>")
    print("寫入後在會話中執行 /reload-plugins 或重開 Claude 才會生效。")


def marketplace_source(market):
    known = load_json(os.path.join(CLAUDE_DIR, "plugins", "known_marketplaces.json"), {})
    m = known.get(market)
    return m.get("source") if m else None


def gitignored(path):
    try:
        r = subprocess.run(["git", "-C", os.path.dirname(path), "check-ignore", "-q", path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode
    except OSError:
        return None


def cmd_toggle(cat, args, turn_on):
    shared = "--shared" in args
    dry = "--dry-run" in args
    sel = [a for a in args if a not in ("--shared", "--dry-run")]
    ids = resolve(cat, sel)
    path = layer_paths()["shared" if shared else "local"]
    data = load_json(path, {})
    ep = dict(data.get("enabledPlugins") or {})
    changes, notes = [], []
    inst = installed_ids()
    for pid in ids:
        if turn_on:
            if ep.get(pid) is not True:
                ep[pid] = True
                changes.append("+ %s: true" % pid)
            if pid not in inst:
                notes.append("%s 未安裝：claude plugin install %s" % (pid, pid))
        elif pid in ep:
            changes.append("- %s（移除此層設定，回到下層的值）" % pid)
            del ep[pid]
    mk_changes = []
    if turn_on and shared:
        mk = dict(data.get("extraKnownMarketplaces") or {})
        for pid in ids:
            market = pid.split("@", 1)[1] if "@" in pid else ""
            if market and market != OFFICIAL and market not in mk:
                src = marketplace_source(market)
                if src:
                    mk[market] = {"source": src}
                    mk_changes.append("+ extraKnownMarketplaces.%s" % market)
                else:
                    notes.append("找不到市場 %s 的來源，同事需自行加入該市場" % market)
        if mk_changes:
            data["extraKnownMarketplaces"] = mk
    layer = "專案共享 .claude/settings.json" if shared else "本地個人 .claude/settings.local.json"
    if not changes and not mk_changes:
        print("無變更（%s 已是目標狀態）" % layer)
    else:
        if not dry:
            if ep:
                data["enabledPlugins"] = ep
            else:
                data.pop("enabledPlugins", None)
            save_json(path, data)
        print("%s%s：" % ("預演，未寫入 " if dry else "已寫入 ", path))
        for c in changes + mk_changes:
            print("  " + c)
    if shared and not dry and changes:
        notes.append("共享設定會進版控；同事需信任此資料夾後才會載入")
    if not shared and gitignored(path) == 1:
        notes.append("%s 沒有被 git 忽略，請確認不要提交" % os.path.relpath(path, project_dir()))
    for n in notes:
        print("注意：" + n)
    if changes and not dry:
        print("在會話中執行 /reload-plugins 或重開 Claude 才會生效。")
    layers = layer_plugins()
    for pid in ids:
        on, src = state(pid, layers)
        print("  %s → %s" % (pid, ("啟用（%s）" % src) if on else "停用"))


def cmd_add(cat, args):
    category = "-"
    if "--category" in args:
        i = args.index("--category")
        if i + 1 >= len(args):
            raise Fail("--category 後要接類別名稱")
        category = args[i + 1]
        args = args[:i] + args[i + 2:]
    if not args or "@" not in args[0]:
        raise Fail("用法：add <名稱@市場> [說明...] [--category 類別]")
    pid, desc = args[0], " ".join(args[1:])
    if any(p["id"] == pid for p in cat["plugins"]):
        raise Fail("%s 已在清單中" % pid)
    cat["plugins"].append({"id": pid, "category": category, "description": desc})
    save_json(CATALOG, cat)
    print("已加入 %s（序號 %d）" % (pid, len(cat["plugins"])))
    if pid not in installed_ids():
        print("注意：%s 尚未安裝：claude plugin install %s" % (pid, pid))
    cmd_list(cat)


def cmd_remove(cat, args):
    ids = resolve(cat, args)
    layers = layer_plugins()
    cat["plugins"] = [p for p in cat["plugins"] if p["id"] not in ids]
    save_json(CATALOG, cat)
    for pid in ids:
        print("已從清單移除 %s" % pid)
        for name, label in (("local", "本地"), ("shared", "共享")):
            if pid in layers[name]:
                print("注意：本專案%s設定仍有 %s，需要時用 off 處理（先用 add 加回清單）" % (label, pid))
    cmd_list(cat)


def cmd_hint():
    try:
        src = json.load(sys.stdin).get("source", "startup")
    except Exception:
        src = "startup"
    if src not in ("startup", "resume"):
        return
    try:
        cat = load_catalog()
        layers = layer_plugins()
        on = [p["id"].split("@")[0] for p in cat["plugins"]
              if state(p["id"], layers) in ((True, "本地"), (True, "共享"))]
        n = len(cat["plugins"])
    except Exception:
        return
    tail = ("本專案另啟用：%s" % "、".join(on)) if on else "本專案未另外啟用"
    msg = "可選插件 %d 個，%s。輸入 /myplugins 查看清單並按序號啟用。" % (n, tail)
    print(json.dumps({"systemMessage": msg}, ensure_ascii=False))


def main(argv):
    cmd = argv[0] if argv else "list"
    rest = argv[1:]
    if cmd == "hint":
        cmd_hint()
        return 0
    cat = load_catalog()
    known = ("list", "status", "enable", "on", "off", "disable", "add", "remove", "rm")
    if cmd not in known and (cmd.isdigit() or cmd == "all" or "," in cmd
                             or any(cmd in (p["id"], p["id"].split("@")[0]) for p in cat["plugins"])):
        cmd, rest = "enable", argv
    if cmd in ("list", "status"):
        cmd_list(cat)
    elif cmd in ("enable", "on"):
        cmd_toggle(cat, rest, True)
    elif cmd in ("off", "disable"):
        cmd_toggle(cat, rest, False)
    elif cmd == "add":
        cmd_add(cat, rest)
    elif cmd in ("remove", "rm"):
        cmd_remove(cat, rest)
    else:
        raise Fail("未知子命令 %s；可用 list、enable、off、add、remove" % cmd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        print("錯誤：%s" % e, file=sys.stderr)
        sys.exit(2)
