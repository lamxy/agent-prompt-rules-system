#!/usr/bin/env python3
"""mysession-eval：在真實專案試用場景配置時，記錄一件事的評估資料並供覆盤匯總。

子命令（由技能呼叫，使用者不直接執行）：
  extract [--session ID]       輸出本會話「上一次記錄之後」區段的客觀指標（JSON）
  append  [選項...]            重新計算區段指標，與 Claude 的推定合併後追加到日誌
  summarize [--scenario S]     匯總日誌供覆盤（JSON）

會話 id 取自環境變數 CLAUDE_CODE_SESSION_ID（或 --session）；找不到會話檔時報錯，不退回其他方式。
環境變數：MSE_CLAUDE_DIR（預設 ~/.claude）、MSE_HOME（日誌目錄，預設 <MSE_CLAUDE_DIR>/mysession-eval）、
MSE_PROJECT_DIR（預設 CLAUDE_PROJECT_DIR 或目前目錄）。
"""
import glob
import json
import os
import sys

SKILL_NAME = "mysession-eval"
INVOKE_MARK = "<command-name>/%s</command-name>" % SKILL_NAME
SCRIPT_MARK = "skills/%s/scripts/%s" % (SKILL_NAME, SKILL_NAME)


class Fail(Exception):
    pass


def claude_dir():
    return os.environ.get("MSE_CLAUDE_DIR") or os.path.expanduser("~/.claude")


def find_session_file(session_id, cdir):
    if not session_id or not session_id.strip():
        raise Fail("取不到會話 id：環境變數 CLAUDE_CODE_SESSION_ID 未設定，也沒有 --session。")
    hits = glob.glob(os.path.join(cdir, "projects", "*", session_id.strip() + ".jsonl"))
    if len(hits) != 1:
        raise Fail("找不到會話記錄檔：%s/projects/*/%s.jsonl（找到 %d 個）"
                   % (cdir, session_id.strip(), len(hits)))
    return hits[0]


def load_entries(path):
    out = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if isinstance(d, dict):
                out.append(d)
    return out


def _content(entry):
    msg = entry.get("message")
    return msg.get("content") if isinstance(msg, dict) else None


def is_invocation(entry):
    if entry.get("type") != "user" or entry.get("isMeta"):
        return False
    c = _content(entry)
    return isinstance(c, str) and INVOKE_MARK in c


def _blocks(entry):
    c = _content(entry)
    return [b for b in c if isinstance(b, dict)] if isinstance(c, list) else []


def is_skill_script_call(entry):
    if entry.get("type") != "assistant":
        return set()
    ids = set()
    for b in _blocks(entry):
        if b.get("type") == "tool_use" and b.get("name") == "Bash":
            cmd = (b.get("input") or {}).get("command") or ""
            if SCRIPT_MARK in cmd:
                ids.add(b.get("id"))
    return ids


def _tool_result_ids(entry):
    if entry.get("type") != "user":
        return set()
    return {b.get("tool_use_id") for b in _blocks(entry) if b.get("type") == "tool_result"}


def segment_bounds(entries):
    inv = [i for i, e in enumerate(entries) if is_invocation(e)]
    end = inv[-1] if inv else len(entries)
    prev = [i for i in inv if i < end]
    if not prev:
        return 0, end
    p = prev[-1]
    start = p + 1
    script_ids = set()
    for i in range(p + 1, end):
        script_ids |= is_skill_script_call(entries[i])
        if _tool_result_ids(entries[i]) & script_ids:
            start = i + 1
    return start, end


SKILL_META_PREFIX = "Base directory for this skill:"
INTERRUPT_PREFIX = "[Request interrupted by user"
DENIAL_KINDS = (
    ("deny_rule", "is in a directory that is denied by your permission settings"),
    ("denied", "has been denied"),
    ("not_granted", "but you haven't granted it yet"),
)
SANDBOX_MARK = "Operation not permitted"
MSG_MAX_CHARS = 300
MSG_HEAD, MSG_TAIL = 10, 20


def _text_of(entry):
    c = _content(entry)
    if isinstance(c, str):
        return c
    return "\n".join(b.get("text", "") for b in _blocks(entry) if b.get("type") == "text")


def _result_text(block):
    c = block.get("content")
    if isinstance(c, list):
        return "\n".join(x.get("text", "") for x in c if isinstance(x, dict))
    return c if isinstance(c, str) else ""


def _slash_name(text):
    if "<command-name>/" not in text:
        return None
    return text.split("<command-name>/", 1)[1].split("</command-name>", 1)[0].strip()


def _new_counts():
    return {"skills": {}, "agents": {}, "mcp": {}, "rules_loaded": {},
            "denials": {"total": 0, "by_kind": {}, "by_tool": {}},
            "tool_errors": {"total": 0, "sandbox": 0}, "interrupts": 0, "compactions": 0,
            "tokens": {"input": 0, "cache_creation": 0, "cache_read": 0, "output": 0}}


def _inc(d, key, n=1):
    d[key] = d.get(key, 0) + n


def _count(entries, lo, hi):
    """Count objective signals in entries[lo:hi]; returns (counts, agent tool_use ids)."""
    c = _new_counts()
    names, skip, seen_msg, agent_ids = {}, set(), set(), set()
    for i in range(lo, hi):
        e = entries[i]
        t = e.get("type")
        skip |= is_skill_script_call(e)
        if t == "assistant":
            msg = e.get("message") or {}
            mid = msg.get("id")
            usage = msg.get("usage")
            if isinstance(usage, dict) and (mid is None or mid not in seen_msg):
                if mid is not None:
                    seen_msg.add(mid)
                for k, src in (("input", "input_tokens"), ("cache_creation", "cache_creation_input_tokens"),
                               ("cache_read", "cache_read_input_tokens"), ("output", "output_tokens")):
                    c["tokens"][k] += int(usage.get(src) or 0)
            for b in _blocks(e):
                if b.get("type") != "tool_use" or b.get("id") in skip:
                    continue
                name, inp = b.get("name") or "", b.get("input") or {}
                names[b.get("id")] = name
                if name == "Skill" and inp.get("skill"):
                    _inc(c["skills"], inp["skill"])
                elif name in ("Agent", "Task"):
                    _inc(c["agents"], inp.get("subagent_type") or "general-purpose")
                    agent_ids.add(b.get("id"))
                elif name.startswith("mcp__"):
                    _inc(c["mcp"], name)
        elif t == "user":
            if not e.get("isMeta"):
                text = _text_of(e)
                if text.lstrip().startswith(INTERRUPT_PREFIX):
                    c["interrupts"] += 1
                sname = _slash_name(text) if isinstance(_content(e), str) else None
                if sname and sname != SKILL_NAME and i + 1 < len(entries):
                    nxt = entries[i + 1]
                    if nxt.get("isMeta") and _text_of(nxt).lstrip().startswith(SKILL_META_PREFIX):
                        _inc(c["skills"], sname)
            for b in _blocks(e):
                if b.get("type") != "tool_result" or not b.get("is_error") or b.get("tool_use_id") in skip:
                    continue
                text = _result_text(b)
                kind = next((k for k, mark in DENIAL_KINDS if mark in text), None)
                if kind:
                    c["denials"]["total"] += 1
                    _inc(c["denials"]["by_kind"], kind)
                    _inc(c["denials"]["by_tool"], names.get(b.get("tool_use_id"), "?"))
                else:
                    c["tool_errors"]["total"] += 1
                    if SANDBOX_MARK in text:
                        c["tool_errors"]["sandbox"] += 1
        elif t == "attachment":
            a = e.get("attachment") or {}
            if a.get("type") == "nested_memory":
                path = a.get("path") or (a.get("content") or {}).get("path")
                if path:
                    _inc(c["rules_loaded"], path)
        elif t == "system" and e.get("subtype") == "compact_boundary":
            c["compactions"] += 1
    return c, agent_ids


def _is_prompt(entry):
    if entry.get("type") != "user" or entry.get("isMeta") or entry.get("isCompactSummary"):
        return False
    c = _content(entry)
    if isinstance(c, list) and not any(b.get("type") == "text" for b in _blocks(entry)):
        return False
    text = _text_of(entry).strip()
    if not text or text.startswith(INTERRUPT_PREFIX) or text.startswith("<local-command-"):
        return False
    return True


def _subagents(subagent_dir, agent_ids):
    out = {"count": 0, "tokens": {"input": 0, "cache_creation": 0, "cache_read": 0, "output": 0},
           "mcp": {}, "denials_total": 0, "tool_errors_total": 0}
    if not subagent_dir or not agent_ids or not os.path.isdir(subagent_dir):
        return out
    for meta_path in sorted(glob.glob(os.path.join(subagent_dir, "agent-*.meta.json"))):
        try:
            with open(meta_path, encoding="utf-8") as f:
                meta = json.load(f)
        except (OSError, ValueError):
            continue
        if meta.get("toolUseId") not in agent_ids:
            continue
        log = meta_path[: -len(".meta.json")] + ".jsonl"
        if not os.path.exists(log):
            continue
        es = load_entries(log)
        c, _ = _count(es, 0, len(es))
        out["count"] += 1
        for k in out["tokens"]:
            out["tokens"][k] += c["tokens"][k]
        for k, n in c["mcp"].items():
            _inc(out["mcp"], k, n)
        out["denials_total"] += c["denials"]["total"]
        out["tool_errors_total"] += c["tool_errors"]["total"]
    return out


def segment_metrics(entries, start, end, subagent_dir):
    c, agent_ids = _count(entries, start, end)
    stamps = [e.get("timestamp") for e in entries[start:end] if e.get("timestamp")]
    c["turns"] = sum(1 for e in entries[start:end] if _is_prompt(e))
    c["empty"] = start >= end or c["turns"] == 0
    c["start_ts"] = stamps[0] if stamps else None
    c["end_ts"] = stamps[-1] if stamps else None
    c["subagents"] = _subagents(subagent_dir, agent_ids)
    return c


def _clean_message(text):
    out = []
    while "<system-reminder>" in text:
        head, rest = text.split("<system-reminder>", 1)
        out.append(head)
        text = rest.split("</system-reminder>", 1)[1] if "</system-reminder>" in rest else ""
    out.append(text)
    text = "".join(out).strip()
    name = _slash_name(text)
    if name:
        args = ""
        if "<command-args>" in text:
            args = text.split("<command-args>", 1)[1].split("</command-args>", 1)[0].strip()
        text = ("/%s %s" % (name, args)).strip()
    return text


def user_messages(entries, start, end, max_chars=MSG_MAX_CHARS, max_count=MSG_HEAD + MSG_TAIL):
    msgs = []
    for e in entries[start:end]:
        if not _is_prompt(e):
            continue
        text = _clean_message(_text_of(e))
        if text:
            msgs.append(text[:max_chars])
    if len(msgs) <= max_count:
        return msgs, 0
    tail = max_count - MSG_HEAD
    return msgs[:MSG_HEAD] + msgs[-tail:], len(msgs) - max_count


HERE = os.path.dirname(os.path.abspath(__file__))
SCENARIOS_FILE = os.path.join(os.path.dirname(HERE), "scenarios.json")
AGENT_MATCH_MIN = 3


def _hash_bytes(data):
    import hashlib
    return hashlib.sha256(data).hexdigest()[:12]


def _file_item(root, kind, name, path):
    with open(path, "rb") as f:
        return {"kind": kind, "name": name, "path": os.path.relpath(path, root), "hash": _hash_bytes(f.read())}


def inventory(project):
    items = []
    claude = os.path.join(project, ".claude")
    for p in sorted(glob.glob(os.path.join(claude, "skills", "*", "SKILL.md"))):
        items.append(_file_item(project, "skill", os.path.basename(os.path.dirname(p)), p))
    for p in sorted(glob.glob(os.path.join(claude, "agents", "*.md"))):
        items.append(_file_item(project, "agent", os.path.basename(p)[:-3], p))
    for p in sorted(glob.glob(os.path.join(claude, "rules", "**", "*.md"), recursive=True)):
        items.append(_file_item(project, "rule", os.path.relpath(p, os.path.join(claude, "rules")), p))
    mcp_path = os.path.join(project, ".mcp.json")
    if os.path.isfile(mcp_path):
        try:
            with open(mcp_path, encoding="utf-8") as f:
                servers = (json.load(f) or {}).get("mcpServers") or {}
        except (OSError, ValueError):
            servers = {}
        for name in sorted(servers):
            blob = json.dumps(servers[name], sort_keys=True, ensure_ascii=False).encode("utf-8")
            items.append({"kind": "mcp", "name": name, "path": ".mcp.json", "hash": _hash_bytes(blob)})
    settings = os.path.join(claude, "settings.json")
    if os.path.isfile(settings):
        items.append(_file_item(project, "settings", "settings.json", settings))
    for rel in ("CLAUDE.md", os.path.join(".claude", "CLAUDE.md")):
        p = os.path.join(project, rel)
        if os.path.isfile(p):
            items.append(_file_item(project, "claude_md", "CLAUDE.md", p))
            break
    return items


def load_scenarios():
    try:
        with open(SCENARIOS_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def detect_scenario(project, items, scenarios):
    md = next((it for it in items if it["kind"] == "claude_md"), None)
    if md:
        try:
            with open(os.path.join(project, md["path"]), encoding="utf-8") as f:
                head = f.readline().strip()
        except OSError:
            head = ""
        for flag, spec in scenarios.items():
            if head and head == spec.get("claude_md_heading"):
                return flag
    agents = {it["name"] for it in items if it["kind"] == "agent"}
    scores = sorted(((len(agents & set(spec.get("agents") or [])), flag) for flag, spec in scenarios.items()),
                    reverse=True)
    if scores and scores[0][0] >= AGENT_MATCH_MIN and (len(scores) == 1 or scores[0][0] > scores[1][0]):
        return scores[0][1]
    return None


def project_dir():
    return os.environ.get("MSE_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()


def _opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            raise Fail("%s 缺少值" % name)
        return args[i + 1]
    return default


def _session_segment(args):
    sid = _opt(args, "--session") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    path = find_session_file(sid, claude_dir())
    entries = load_entries(path)
    start, end = segment_bounds(entries)
    metrics = segment_metrics(entries, start, end, os.path.join(path[: -len(".jsonl")], "subagents"))
    return sid.strip(), entries, start, end, metrics


def cmd_extract(args):
    sid, entries, start, end, metrics = _session_segment(args)
    msgs, omitted = user_messages(entries, start, end)
    proj = project_dir()
    items = inventory(proj)
    name = os.path.basename(os.path.abspath(proj))
    out = {"session_id": sid, "project": name,
           "scenario": detect_scenario(proj, items, load_scenarios()), "installed": items,
           "segment": metrics, "user_messages": msgs, "user_messages_omitted": omitted,
           "recent_tasks": recent_tasks(home_dir(), name)}
    print(json.dumps(out, ensure_ascii=False))


SCHEMA = 1
SCENARIO_THRESHOLD = 10
ITEM_THRESHOLD = 3
RECENT_TASKS = 10


def home_dir():
    return os.environ.get("MSE_HOME") or os.path.join(claude_dir(), SKILL_NAME)


def log_path(home):
    return os.path.join(home, "log.jsonl")


def read_log(home):
    """Returns (records, bad_line_count)."""
    path = log_path(home)
    if not os.path.exists(path):
        return [], 0
    records, bad = [], 0
    with open(path, encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue
            try:
                d = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if isinstance(d, dict):
                records.append(d)
            else:
                bad += 1
    return records, bad


def recent_tasks(home, project):
    out = []
    for r in reversed(read_log(home)[0]):
        t = r.get("task")
        if r.get("project") == project and t and t not in out:
            out.append(t)
        if len(out) >= RECENT_TASKS:
            break
    return out


def scenario_counts(home, scenario):
    recs = [r for r in read_log(home)[0] if r.get("scenario") == scenario]
    return sum(1 for r in recs if r.get("include") is True), len(recs)


def _int_opt(args, name, lo=0, hi=None):
    raw = _opt(args, name)
    if raw is None:
        raise Fail("缺少 %s" % name)
    try:
        v = int(raw)
    except ValueError:
        raise Fail("%s 必須是整數：%s" % (name, raw))
    if v < lo or (hi is not None and v > hi):
        raise Fail("%s 超出範圍：%s" % (name, raw))
    return v


def _choice_opt(args, name, choices):
    v = _opt(args, name)
    if v not in choices:
        raise Fail("%s 必須是 %s 之一" % (name, "／".join(choices)))
    return v


def cmd_append(args):
    task = (_opt(args, "--task") or "").strip()
    if not task:
        raise Fail("缺少 --task")
    status = _choice_opt(args, "--status", ("done", "partial", "aborted"))
    corrections = _int_opt(args, "--corrections")
    new_requests = _int_opt(args, "--new-requests")
    sat = _int_opt(args, "--satisfaction", 1, 5)
    sat_source = _choice_opt(args, "--sat-source", ("estimated", "user"))
    include = _choice_opt(args, "--include", ("yes", "no")) == "yes"
    reason = (_opt(args, "--exclude-reason") or "").strip()
    if not include and not reason:
        raise Fail("--include no 時必須給 --exclude-reason")
    missed = [x.strip() for x in (_opt(args, "--missed") or "").split(",") if x.strip()]

    sid, entries, start, end, metrics = _session_segment(args)
    if metrics["empty"]:
        raise Fail("自上次記錄後沒有新活動，不寫入。")
    proj = project_dir()
    items = inventory(proj)
    scenario = _opt(args, "--scenario") or detect_scenario(proj, items, load_scenarios()) or "unknown"
    import datetime
    record = {
        "schema": SCHEMA,
        "recorded_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "session_id": sid, "project": os.path.basename(os.path.abspath(proj)), "scenario": scenario,
        "installed": items, "metrics": metrics, "task": task, "status": status,
        "corrections": corrections, "new_requests": new_requests,
        "satisfaction": sat, "satisfaction_source": sat_source,
        "basis": (_opt(args, "--basis") or "").strip(), "include": include,
        "exclude_reason": reason, "missed": missed, "note": (_opt(args, "--note") or "").strip(),
    }
    home = home_dir()
    os.makedirs(home, exist_ok=True)
    with open(log_path(home), "a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")
    included, _ = scenario_counts(home, scenario)
    line = "已記錄：%s（%s，滿意度 %d〔%s〕）。%s 已累積 %d 筆列入判定，場景判定門檻 %d 筆" % (
        task, scenario, sat, "推定" if sat_source == "estimated" else "使用者確認",
        scenario, included, SCENARIO_THRESHOLD)
    if included >= SCENARIO_THRESHOLD:
        line += "，可覆盤"
    if not include:
        line += "（本筆不列入判定：%s）" % reason
    print(line)


COMMANDS = {"extract": cmd_extract, "append": cmd_append}


def main(argv):
    if not argv:
        raise Fail("缺少子命令：extract、append 或 summarize。")
    fn = COMMANDS.get(argv[0])
    if not fn:
        raise Fail("未知子命令：%s" % argv[0])
    fn(argv[1:])


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Fail as e:
        sys.stderr.write("錯誤：%s\n" % e)
        sys.exit(2)
