{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "terraform@claude-plugins-official": true,
        "semgrep@claude-plugins-official": true,
        "sonatype-guide@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true
    },
    "permissions": {
        "ask": [
            "Bash(terraform apply*)",
            "Bash(terraform destroy*)",
            "Bash(terraform import *)",
            "Bash(terraform state *)",
            "Bash(docker compose up*)",
            "Bash(docker compose * up*)",
            "Bash(docker compose down*)",
            "Bash(docker compose * down*)",
            "Bash(docker compose rm*)",
            "Bash(docker compose * rm*)",
            "Bash(docker rm *)",
            "Bash(docker container rm *)",
            "Bash(docker volume rm *)",
            "Bash(docker volume prune*)",
            "Bash(docker system prune*)",
            "Bash(docker image prune*)",
            "Bash(docker network rm *)",
            "Bash(docker context use *)"
        ]
    },
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        }
    }
}
