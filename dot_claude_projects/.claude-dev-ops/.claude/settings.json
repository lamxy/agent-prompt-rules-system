{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "terraform@claude-plugins-official": true,
        "grafana-mcp@claude-plugins-official": true,
        "sentry@claude-plugins-official": true,
        "semgrep@claude-plugins-official": true,
        "sonatype-guide@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true
    },
    "permissions": {
        "ask": [
            "Bash(terraform apply*)",
            "Bash(terraform destroy*)",
            "Bash(terraform import *)",
            "Bash(terraform state *)",
            "Bash(kubectl apply *)",
            "Bash(kubectl * apply *)",
            "Bash(kubectl delete *)",
            "Bash(kubectl * delete *)",
            "Bash(kubectl scale *)",
            "Bash(kubectl * scale *)",
            "Bash(kubectl rollout *)",
            "Bash(kubectl * rollout *)",
            "Bash(kubectl patch *)",
            "Bash(kubectl * patch *)",
            "Bash(kubectl edit *)",
            "Bash(kubectl drain *)",
            "Bash(kubectl cordon *)",
            "Bash(helm install *)",
            "Bash(helm upgrade *)",
            "Bash(helm uninstall *)",
            "Bash(helm rollback *)"
        ]
    },
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        }
    }
}
