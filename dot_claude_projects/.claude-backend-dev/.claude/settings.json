{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "gopls-lsp@claude-plugins-official": true,
        "postman@claude-plugins-official": true,
        "mongodb@claude-plugins-official": true,
        "redis-development@claude-plugins-official": true,
        "semgrep@claude-plugins-official": true,
        "sentry@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true
    },
    "permissions": {
        "deny": [
            "Bash(mongosh *--eval *drop*)",
            "Bash(mongosh *--eval *deleteMany*)",
            "Bash(mongosh *--eval *remove*)",
            "Bash(mongosh *--eval *updateMany*)",
            "Bash(mongo *--eval *drop*)",
            "Bash(mongo *--eval *deleteMany*)",
            "Bash(mysql *-e *DROP*)",
            "Bash(mysql *-e *TRUNCATE*)",
            "Bash(mysql *-e *DELETE*)",
            "Bash(psql *-c *DROP*)",
            "Bash(psql *-c *TRUNCATE*)",
            "Bash(psql *-c *DELETE*)",
            "Bash(redis-cli *flushall*)",
            "Bash(redis-cli *FLUSHALL*)",
            "Bash(redis-cli *flushdb*)",
            "Bash(redis-cli *FLUSHDB*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/go-fmt.sh"
                    }
                ]
            }
        ]
    },
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        }
    }
}
